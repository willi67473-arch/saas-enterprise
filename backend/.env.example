# --- Sécurité ---------------------------------------------------------------
# Généré automatiquement par setup.sh / setup.bat. À défaut : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données : sqlite (défaut) | postgresql | mysql ----------------
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Frontend / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Jetons d'authentification ---------------------------------------------
TOKEN_LIFETIME_DAYS=7
